{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"types": ["node", "@wdio/globals/types", "@wdio/mocha-framework", "@wdio/electrobun-service"],
		"skipLibCheck": true,
		"noEmit": true,
		"strict": true
	},
	"include": ["*.ts", "specs"]
}
